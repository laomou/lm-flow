# sdist 必须自带整个引擎源 —— 否则在没有预编译 wheel 的平台上,
# `pip install lm-flow` 会因为找不到 Rust/C++ 源而构建失败。
include README.md LICENSE pyproject.toml setup.py
include Cargo.toml Cargo.lock

# Rust 引擎(排除编译产物)
recursive-include crates *.rs *.toml
graft crates
prune crates/**/target

# C ABI 头文件、C++ 糖层、内置算子、pybind11 绑定
recursive-include include *.h *.hpp
recursive-include cpp *.cc *.h
recursive-include python/src *.cc *.h

# 别把构建/缓存/开发产物打进源包
global-exclude *.so *.pyd *.o *.a *.pyc
global-exclude __pycache__/*
prune target
prune build
prune .pydeps
prune dist
prune wheelhouse
