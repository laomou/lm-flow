@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

if(NOT TARGET lmflow::core_static)
  add_library(lmflow::core_static STATIC IMPORTED)
  set_target_properties(lmflow::core_static PROPERTIES
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/@LMFLOW_CORE_INSTALL_FILENAME@"
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include")
  target_link_libraries(lmflow::core_static INTERFACE Threads::Threads)
  if(WIN32)
    target_link_libraries(lmflow::core_static INTERFACE kernel32 ntdll userenv ws2_32 dbghelp)
  else()
    target_link_libraries(lmflow::core_static INTERFACE ${CMAKE_DL_LIBS} m)
  endif()
  if(MSVC)
    target_compile_options(lmflow::core_static INTERFACE /MD)
  endif()
endif()

if(@LMFLOW_BUILD_KERNELS@ AND NOT TARGET lmflow::kernels)
  add_library(lmflow::kernels_archive STATIC IMPORTED)
  set_target_properties(lmflow::kernels_archive PROPERTIES
    IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/@CMAKE_STATIC_LIBRARY_PREFIX@lmflow_kernels@CMAKE_STATIC_LIBRARY_SUFFIX@"
    INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include")
  target_link_libraries(lmflow::kernels_archive INTERFACE lmflow::core_static)

  add_library(lmflow::kernels INTERFACE IMPORTED)
  if(MSVC)
    target_link_libraries(lmflow::kernels INTERFACE lmflow::kernels_archive)
    target_link_options(lmflow::kernels INTERFACE
      "/WHOLEARCHIVE:$<TARGET_FILE:lmflow::kernels_archive>")
  elseif(APPLE)
    target_link_libraries(lmflow::kernels INTERFACE lmflow::kernels_archive)
    target_link_options(lmflow::kernels INTERFACE
      "SHELL:-Wl,-force_load,$<TARGET_FILE:lmflow::kernels_archive>")
  else()
    target_link_libraries(lmflow::kernels INTERFACE
      "-Wl,--whole-archive" lmflow::kernels_archive "-Wl,--no-whole-archive")
  endif()
endif()

if(@LMFLOW_BUILD_SHARED_LIBS@)
  if(NOT TARGET lmflow::core)
    add_library(lmflow::core SHARED IMPORTED)
    if(WIN32)
      set_target_properties(lmflow::core PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/bin/lmflow_core@CMAKE_SHARED_LIBRARY_SUFFIX@"
        IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/lib/lmflow_core@CMAKE_IMPORT_LIBRARY_SUFFIX@")
    else()
      set_target_properties(lmflow::core PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/@CMAKE_SHARED_LIBRARY_PREFIX@lmflow_core@CMAKE_SHARED_LIBRARY_SUFFIX@")
    endif()
    set_target_properties(lmflow::core PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include")
  endif()

  if(NOT TARGET lmflow::lmflow)
    add_library(lmflow::lmflow SHARED IMPORTED)
    if(WIN32)
      set_target_properties(lmflow::lmflow PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/bin/lmflow@CMAKE_SHARED_LIBRARY_SUFFIX@"
        IMPORTED_IMPLIB "${PACKAGE_PREFIX_DIR}/lib/lmflow@CMAKE_IMPORT_LIBRARY_SUFFIX@")
    else()
      set_target_properties(lmflow::lmflow PROPERTIES
        IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/lib/@CMAKE_SHARED_LIBRARY_PREFIX@lmflow@CMAKE_SHARED_LIBRARY_SUFFIX@")
    endif()
    set_target_properties(lmflow::lmflow PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include")
  endif()
else()
  if(NOT TARGET lmflow::core)
    add_library(lmflow::core INTERFACE IMPORTED)
    target_link_libraries(lmflow::core INTERFACE lmflow::core_static)
  endif()

  if(NOT TARGET lmflow::lmflow)
    add_library(lmflow::lmflow INTERFACE IMPORTED)
    if(@LMFLOW_BUILD_KERNELS@)
      target_link_libraries(lmflow::lmflow INTERFACE lmflow::kernels)
    endif()
    target_link_libraries(lmflow::lmflow INTERFACE lmflow::core_static)
  endif()
endif()

set(lmflow_opencv_FOUND FALSE)
if("opencv" IN_LIST lmflow_FIND_COMPONENTS)
  if(@LMFLOW_BUILD_OPENCV_ADAPTER@)
    find_dependency(OpenCV REQUIRED COMPONENTS core)
    if(NOT TARGET lmflow::opencv)
      add_library(lmflow::opencv INTERFACE IMPORTED)
      set_target_properties(lmflow::opencv PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES
          "${PACKAGE_PREFIX_DIR}/include;${OpenCV_INCLUDE_DIRS}"
        INTERFACE_LINK_LIBRARIES
          "lmflow::lmflow;${OpenCV_LIBS}")
    endif()
    set(lmflow_opencv_FOUND TRUE)
  else()
    set(lmflow_opencv_NOT_FOUND_MESSAGE
      "This lmflow SDK was built without the optional OpenCV adapter")
  endif()
endif()

set(lmflow_opencl_FOUND FALSE)
if("opencl" IN_LIST lmflow_FIND_COMPONENTS)
  if(@LMFLOW_BUILD_OPENCL_ADAPTER@)
    find_dependency(OpenCL REQUIRED)
    if(NOT TARGET lmflow::opencl)
      add_library(lmflow::opencl INTERFACE IMPORTED)
      set_target_properties(lmflow::opencl PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES
          "${PACKAGE_PREFIX_DIR}/include"
        INTERFACE_LINK_LIBRARIES
          "lmflow::lmflow;OpenCL::OpenCL")
    endif()
    set(lmflow_opencl_FOUND TRUE)
  else()
    set(lmflow_opencl_NOT_FOUND_MESSAGE
      "This lmflow SDK was built without the optional OpenCL adapter")
  endif()
endif()

set(lmflow_vulkan_FOUND FALSE)
if("vulkan" IN_LIST lmflow_FIND_COMPONENTS)
  if(@LMFLOW_BUILD_VULKAN_ADAPTER@)
    find_dependency(Vulkan REQUIRED)
    if(NOT TARGET lmflow::vulkan)
      add_library(lmflow::vulkan INTERFACE IMPORTED)
      set_target_properties(lmflow::vulkan PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES
          "${PACKAGE_PREFIX_DIR}/include"
        INTERFACE_LINK_LIBRARIES
          "lmflow::lmflow;Vulkan::Vulkan")
    endif()
    set(lmflow_vulkan_FOUND TRUE)
  else()
    set(lmflow_vulkan_NOT_FOUND_MESSAGE
      "This lmflow SDK was built without the optional Vulkan adapter")
  endif()
endif()

check_required_components(lmflow)
