# Rust(引擎是独立 crate,target 落在 lmflow/core 下;Cargo.lock 提交以复现构建)
/lmflow/core/target/
/lmflow/examples/rust/*/target/
**/*.rs.bk

# C/C++
*.o
*.a
*.so
*.dylib
*.dll

# Python
lmflow/python/lmflow/*.so
lmflow/python/lmflow/*.pyd
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
buildpy/
.pytest_cache/

# 本地测试解包的构建依赖(scikit-build-core / numpy),不进仓库
/.pydeps-test/
/.pydeps/
/.pydeps-wheels/

# 文档站产物(docs/web/build.py + cargo doc + pdoc 合出来的 site/)
/site/

# 编辑器 / 工具
.vscode/
.idea/
compile_commands.json
.cache/
