#version 450
// 测试用的最小 compute shader:out[i] = in[i] * factor
// SPIR-V 由 tests/scale_spv.h 内嵌,重新生成:
//   glslangValidator -V -o /tmp/scale.spv adapters/vulkan/tests/scale.comp
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly  buffer InBuf  { float data[]; } src;
layout(std430, binding = 1) writeonly buffer OutBuf { float data[]; } dst;
layout(push_constant) uniform Params { float factor; uint count; } params;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= params.count) return;
  dst.data[i] = src.data[i] * params.factor;
}
